@baseUrl = http://localhost:8000

### 201 - registers a new user (unique email on every send)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "user{{$timestamp}}@example.com",
  "password": "a-long-enough-password"
}

### 409 - send this twice; the first send may be 201, the second is always 409
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "duplicate@example.com",
  "password": "a-long-enough-password"
}

### 422 - invalid email
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "not-an-email",
  "password": "a-long-enough-password"
}

### 422 - password too short (min 15)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "short@example.com",
  "password": "tooshort"
}

### 422 - password too long (max 128)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "long@example.com",
  "password": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
}

### 422 - password equals the email (too easy to guess)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "same-as-password@example.com",
  "password": "same-as-password@example.com"
}

### 422 - password is the service name, padded to min length with spaces
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "service@example.com",
  "password": "vacation planner"
}

### 422 - missing fields
POST {{baseUrl}}/auth/register
Content-Type: application/json

{}
