
# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Names only here: values must stay empty in this file.
ANTHROPIC_API_KEY=
# Optional: development (default), test or production
# APP_ENV=
# Required: signs access tokens (at least 32 characters). Generate one with:  openssl rand -hex 32
JWT_SECRET=
# Optional: where the SQLite database file lives (default sqlite:///./app.db)
# DATABASE_URL=
# Optional: minutes an access token stays valid (default 30)
# ACCESS_TOKEN_EXPIRE_MINUTES=
# Optional: the default model for LLM calls (default claude-haiku-5-5)
# LLM_MODEL=
# Optional: send API calls through a proxy or gateway (default: api.anthropic.com)
# ANTHROPIC_BASE_URL=
# Optional: seconds one LLM call may take before it times out (default 30, at most 300)
# LLM_TIMEOUT_SECONDS=
# Optional: how many times a failed LLM call is retried (default 2, at most 5)
# LLM_MAX_RETRIES=
# LLM_GENERATION_ATTEMPTS=
# Optional: needed only for the voice features (speech to text, spoken replies). Never commit it.
# OPENAI_API_KEY=
# Optional: the speech-to-text model (default gpt-transcribe)
# VOICE_STT_MODEL=
# Optional: the largest audio upload in bytes (default 2000000, at most 25000000)
# VOICE_MAX_UPLOAD_BYTES=
# Optional: seconds one agent run (POST /agent/plan) may take in all (default 90, at most 600)
# AGENT_TIMEOUT_SECONDS=
# Optional: the file where agent conversations are kept (default agent-checkpoints.sqlite)
# AGENT_CHECKPOINT_PATH=
# Optional: the longest the client waits between retries, even if the provider asks for more (default 20)
# LLM_MAX_RETRY_WAIT_SECONDS=
# Optional: DEBUG, INFO (default), WARNING or ERROR
# LOG_LEVEL=
# Optional: where the LLM spend ledger is written (default llm-ledger.jsonl)
# LLM_LEDGER_PATH=
# KNOWLEDGE_STORE_PATH=
# Optional: rate limits, rules such as 5/minute;20/hour counted in this process (ADR 0048).
# RATE_LIMIT_ENABLED=
# RATE_LIMIT_REGISTER=
# RATE_LIMIT_LOGIN=
# RATE_LIMIT_LOGIN_EMAIL=
# RATE_LIMIT_LLM=
# RATE_LIMIT_TOOLS=
# Optional: where trace spans go, none (default) or console (one JSON line per span on stderr) (ADR 0049)
# OTEL_TRACES_EXPORTER=
