meta {
  name: Update trip
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/trips/{{trip_id}}
  body: json
  auth: inherit
}

body:json {
  {
    "destination": "Lisbon",
    "days": 4,
    "budget": 2000,
    "trip_style": "relaxed"
  }
}

docs {
  Full replace: every field required. 409 if the new day count is shorter than the itinerary.
}
