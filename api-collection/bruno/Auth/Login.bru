meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  username: {{email}}
  password: {{password}}
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("token", res.body.access_token);
  }
}

docs {
  OAuth2 password form: `username` carries the email. Saves access_token as the `token` variable.
}
